<Window x:Class="WPF_BGPU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пульсар"
        Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="Black">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#1A1A2E" Padding="10">
			<TextBlock Text="Пульсар - Анимация радиального градиента"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
		</Border>

		<Border Grid.Row="1" Background="#0F0F1A" Margin="20" CornerRadius="20">
			<Grid>
				<Ellipse x:Name="pulsarEllipse"
                         Width="300"
                         Height="300"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Stroke="#333355"
                         StrokeThickness="2"/>

				<TextBlock x:Name="stateText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,0,30">
					Состояние: Покой
				</TextBlock>
			</Grid>
		</Border>

		<Border Grid.Row="2" Background="#1A1A2E" Padding="10">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
				<Button x:Name="startButton"
                        Content="▶ Старт"
                        Width="100" Height="35"
                        Background="#2ECC71"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="StartButton_Click"
                        Margin="5"
                        Cursor="Hand"/>

				<Button x:Name="stopButton"
                        Content="⏸ Стоп"
                        Width="100" Height="35"
                        Background="#E74C3C"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="StopButton_Click"
                        Margin="5"
                        Cursor="Hand"/>

				<Button x:Name="resetButton"
                        Content="⟳ Сброс"
                        Width="100" Height="35"
                        Background="#3498DB"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="ResetButton_Click"
                        Margin="5"
                        Cursor="Hand"/>

				<Separator Width="20" Opacity="0"/>

				<TextBlock Text="Скорость:"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="10,0,5,0"/>

				<Slider x:Name="speedSlider"
                        Width="150"
                        Minimum="0.5"
                        Maximum="3"
                        Value="1"
                        ValueChanged="SpeedSlider_ValueChanged"
                        Margin="5"/>

				<TextBlock x:Name="speedValue"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Width="40"
                           Text="1.0"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>