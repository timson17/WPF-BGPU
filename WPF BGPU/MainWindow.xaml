<Window x:Class="WPF_BGPU.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Анимация шара" Height="400" Width="400"
Background="Black">

	<Grid>

		<!-- ОТРАЖЕНИЕ -->
		<Ellipse Width="200" Height="200"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Opacity="0.3"
                 Margin="0,200,0,0">

			<Ellipse.RenderTransform>
				<ScaleTransform ScaleY="-1"/>
			</Ellipse.RenderTransform>

			<Ellipse.Fill>
				<RadialGradientBrush x:Name="reflectionBrush"
                                     GradientOrigin="0.3,0.3"
                                     Center="0.5,0.5">
					<GradientStop Color="White" Offset="0"/>
					<GradientStop Color="Blue" Offset="1"/>
				</RadialGradientBrush>
			</Ellipse.Fill>
		</Ellipse>

		<!-- ОСНОВНОЙ ШАР -->
		<Ellipse Width="200" Height="200"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center">

			<Ellipse.Fill>
				<RadialGradientBrush x:Name="mainBrush"
                                     GradientOrigin="0.3,0.3"
                                     Center="0.5,0.5">
					<GradientStop Color="White" Offset="0"/>
					<GradientStop Color="Blue" Offset="1"/>
				</RadialGradientBrush>
			</Ellipse.Fill>

		</Ellipse>

		<!-- АНИМАЦИЯ -->
		<Grid.Triggers>
			<EventTrigger RoutedEvent="Grid.Loaded">
				<BeginStoryboard>
					<Storyboard RepeatBehavior="Forever" AutoReverse="True">

						<!-- ДВИЖЕНИЕ ИСТОЧНИКА СВЕТА -->
						<PointAnimation Storyboard.TargetName="mainBrush"
                                        Storyboard.TargetProperty="GradientOrigin"
                                        From="0.2,0.2" To="0.8,0.8"
                                        Duration="0:0:3"/>

						<!-- ДВИЖЕНИЕ СВЕТОВОГО ПЯТНА -->
						<PointAnimation Storyboard.TargetName="mainBrush"
                                        Storyboard.TargetProperty="Center"
                                        From="0.4,0.4" To="0.6,0.6"
                                        Duration="0:0:3"/>

						<!-- ОТРАЖЕНИЕ (движется синхронно) -->
						<PointAnimation Storyboard.TargetName="reflectionBrush"
                                        Storyboard.TargetProperty="GradientOrigin"
                                        From="0.2,0.8" To="0.8,0.2"
                                        Duration="0:0:3"/>

						<PointAnimation Storyboard.TargetName="reflectionBrush"
                                        Storyboard.TargetProperty="Center"
                                        From="0.4,0.6" To="0.6,0.4"
                                        Duration="0:0:3"/>

					</Storyboard>
				</BeginStoryboard>
			</EventTrigger>
		</Grid.Triggers>

	</Grid>

</Window>