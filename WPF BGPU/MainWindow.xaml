<Window x:Class="WPF_RunningButton.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Убегающая кнопка" Height="450" Width="600">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Панель управления -->
		<StackPanel Grid.Row="0" Background="Gray" Margin="0,0,0,10">
			<TextBlock Text="Убегающая кнопка" FontSize="16" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="5"/>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
				<TextBlock Text="Скорость:" Foreground="White"/>
				<Slider x:Name="speedSlider" Width="100" Minimum="1" Maximum="10" Value="5" Margin="5,0,10,0"/>
				<TextBlock x:Name="speedText" Foreground="White" Text="5"/>
			</StackPanel>
		</StackPanel>

		<!-- Игровая область -->
		<Canvas x:Name="gameCanvas" Grid.Row="1" Background="LightGray">
			<Button x:Name="runButton"
                    Content="Нажми меня"
                    Width="100" Height="40"
                    Background="Red" Foreground="White"
                    FontSize="12" FontWeight="Bold"
                    MouseEnter="runButton_MouseEnter"
                    Click="runButton_Click"/>
		</Canvas>

		<!-- Счетчик -->
		<Border Background="White" BorderBrush="Black" BorderThickness="1"
                CornerRadius="5" Width="100" Height="80"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,40,10,0">
			<StackPanel Margin="5">
				<TextBlock Text="Статистика" FontWeight="Bold" HorizontalAlignment="Center"/>
				<TextBlock x:Name="attemptsText" Text="0"/>
				<TextBlock x:Name="successText" Text="0"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>