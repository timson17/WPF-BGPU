<Window x:Class="WPF_BGPU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Текстовый редактор" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">

	<Window.Resources>
		<!-- Градиентный фон для текстовых полей -->
		<LinearGradientBrush x:Key="TextBoxGradient" StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="LightBlue" Offset="0"/>
			<GradientStop Color="LightGreen" Offset="0.5"/>
			<GradientStop Color="LightYellow" Offset="1"/>
		</LinearGradientBrush>

		<!-- Стиль для текстовых полей с градиентом -->
		<Style TargetType="TextBox" x:Key="GradientTextBox">
			<Setter Property="Background" Value="{StaticResource TextBoxGradient}"/>
			<Setter Property="Margin" Value="10"/>
			<Setter Property="Padding" Value="5"/>
			<Setter Property="Height" Value="120"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="AcceptsReturn" Value="True"/>
			<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontFamily" Value="Arial"/>
			<Setter Property="Foreground" Value="Black"/>
		</Style>

		<!-- Базовый стиль для кнопок -->
		<Style TargetType="Button" x:Key="BaseButtonStyle">
			<Setter Property="Margin" Value="10,5"/>
			<Setter Property="Padding" Value="15,8"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="Gray"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="2"/>

			<!-- Триггер при наведении курсора -->
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Opacity" Value="0.8"/>
					<Setter Property="RenderTransform">
						<Setter.Value>
							<ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
						</Setter.Value>
					</Setter>
					<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
				</Trigger>

				<!-- Триггер при нажатии -->
				<Trigger Property="IsPressed" Value="True">
					<Setter Property="Opacity" Value="0.6"/>
					<Setter Property="RenderTransform">
						<Setter.Value>
							<ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
						</Setter.Value>
					</Setter>
					<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- Стиль для кнопки Открыть -->
		<Style TargetType="Button" x:Key="OpenButtonStyle" BasedOn="{StaticResource BaseButtonStyle}">
			<Setter Property="Background" Value="Green"/>
			<Setter Property="BorderBrush" Value="DarkGreen"/>
		</Style>

		<!-- Стиль для кнопки Очистить -->
		<Style TargetType="Button" x:Key="ClearButtonStyle" BasedOn="{StaticResource BaseButtonStyle}">
			<Setter Property="Background" Value="Orange"/>
			<Setter Property="Foreground" Value="Black"/>
			<Setter Property="BorderBrush" Value="DarkOrange"/>
		</Style>

		<!-- Стиль для кнопки Закрыть (активное состояние) -->
		<Style TargetType="Button" x:Key="CloseButtonActiveStyle" BasedOn="{StaticResource BaseButtonStyle}">
			<Setter Property="Background" Value="Red"/>
			<Setter Property="BorderBrush" Value="DarkRed"/>
			<Setter Property="IsEnabled" Value="True"/>
		</Style>

		<!-- Стиль для кнопки Закрыть (неактивное состояние) -->
		<Style TargetType="Button" x:Key="CloseButtonDisabledStyle" BasedOn="{StaticResource BaseButtonStyle}">
			<Setter Property="Background" Value="Gray"/>
			<Setter Property="Foreground" Value="LightGray"/>
			<Setter Property="BorderBrush" Value="DarkGray"/>
			<Setter Property="IsEnabled" Value="False"/>
		</Style>
	</Window.Resources>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Выпадающий список для выбора стиля текста -->
		<StackPanel Grid.Row="0" Margin="0,0,0,10">
			<TextBlock Text="Выберите стиль текста:" FontSize="14" FontWeight="Bold" Margin="10,5"/>
			<ComboBox x:Name="StyleComboBox"
                      Width="200"
                      Height="30"
                      HorizontalAlignment="Left"
                      Margin="10,0"
                      SelectionChanged="StyleComboBox_SelectionChanged">
				<ComboBoxItem Content="Стиль 1 (Arial, 12, Черный)" IsSelected="True"/>
				<ComboBoxItem Content="Стиль 2 (Times New Roman, 14, Синий)"/>
				<ComboBoxItem Content="Стиль 3 (Courier New, 11, Красный)"/>
				<ComboBoxItem Content="Стиль 4 (Verdana, 16, Темно-зеленый)"/>
				<ComboBoxItem Content="Стиль 5 (Comic Sans MS, 13, Фиолетовый)"/>
			</ComboBox>
		</StackPanel>

		<!-- Два текстовых поля -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<TextBox x:Name="TextBox1"
                     Grid.Column="0"
                     Style="{StaticResource GradientTextBox}"
                     TextChanged="TextBox_TextChanged"
                     Text=""/>

			<TextBox x:Name="TextBox2"
                     Grid.Column="1"
                     Style="{StaticResource GradientTextBox}"
                     TextChanged="TextBox_TextChanged"
                     Text=""/>
		</Grid>

		<!-- Кнопки -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
			<Button x:Name="OpenButton"
                    Style="{StaticResource OpenButtonStyle}"
                    Click="OpenButton_Click">
				Открыть
			</Button>

			<Button x:Name="ClearButton"
                    Style="{StaticResource ClearButtonStyle}"
                    Click="ClearButton_Click">
				Очистить
			</Button>

			<Button x:Name="CloseButton"
                    Style="{StaticResource CloseButtonDisabledStyle}"
                    Click="CloseButton_Click">
				Закрыть
			</Button>
		</StackPanel>
	</Grid>
</Window>