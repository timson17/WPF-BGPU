<Window x:Class="WPF_BGPU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InkCanvas Binding Demo" Height="400" Width="600">

    <Window.Resources>
        <!-- Список режимов редактирования InkCanvas -->
        <x:Array x:Key="MyEditingModes" x:Type="{x:Type InkCanvasEditingMode}">
            <x:Static Member="InkCanvasEditingMode.Ink"/>
            <x:Static Member="InkCanvasEditingMode.Select"/>
            <x:Static Member="InkCanvasEditingMode.EraseByPoint"/>
            <x:Static Member="InkCanvasEditingMode.EraseByStroke"/>
        </x:Array>

        <!-- Список атрибутов рисования (цвет, ширина, высота) -->
        <x:Array x:Key="MyDrawingAttributes" x:Type="{x:Type DrawingAttributes}">
            <DrawingAttributes Color="Red" Width="3" Height="3"/>
            <DrawingAttributes Color="Green" Width="10" Height="10"/>
            <DrawingAttributes Color="Blue" Width="15" Height="15"/>
        </x:Array>
    </Window.Resources>

    <StackPanel Margin="10">
        <TextBlock Text="Выберите режим рисования:" FontWeight="Bold"/>
        <ListBox x:Name="lbEditingModes"
                 ItemsSource="{StaticResource MyEditingModes}"
                 SelectedValue="{Binding ElementName=inkCanvas, Path=EditingMode}"
                 Margin="0,5,0,10" />

        <TextBlock Text="Выберите параметры пера:" FontWeight="Bold"/>
        <ListBox x:Name="lbDrawingAttributes"
                 ItemsSource="{StaticResource MyDrawingAttributes}"
                 SelectedValue="{Binding ElementName=inkCanvas, Path=DefaultDrawingAttributes}"
                 Margin="0,5,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="20" Height="20" Fill="{Binding Color}" Stroke="Black" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Color}" Margin="0,0,5,0"/>
                        <TextBlock Text="Ширина:"/>
                        <TextBlock Text="{Binding Width}" Margin="2,0,5,0"/>
                        <TextBlock Text="Высота:"/>
                        <TextBlock Text="{Binding Height}" Margin="2,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <InkCanvas x:Name="inkCanvas" Height="200" Background="LightGray"/>
    </StackPanel>
</Window>
