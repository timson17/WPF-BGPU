<Window x:Class="WPF_BGPU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Style Demo" Height="250" Width="450">

    <Window.Resources>

        <!-- Родительский стиль -->
        <Style TargetType="Button" x:Key="DocButton">
            <Setter Property="Background" Value="DarkBlue" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Verdana" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="5" />
        </Style>

        <!-- Дочерний стиль на основе родительского -->
        <Style BasedOn="{StaticResource DocButton}"
               TargetType="Button"
               x:Key="ActiveDocButton">
            <Setter Property="Background" Value="DarkRed" />
        </Style>

        <!-- Стиль со встроенным EventSetter для всех кнопок -->
        <Style TargetType="Button" x:Key="GlobalButtonStyle">
            <Setter Property="Margin" Value="5" />
            <EventSetter Event="Click" Handler="Button_Click" />
        </Style>

    </Window.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

        <Button Style="{StaticResource ActiveDocButton}">
            Открыть
        </Button>

        <Button Style="{StaticResource DocButton}">
            Обработать
        </Button>

        <Button Style="{StaticResource DocButton}">
            Сохранить
        </Button>

        <Button Padding="5" Margin="5" Background="Green">
            Закрыть
        </Button>

        <Button Style="{StaticResource GlobalButtonStyle}">
            Нажми меня
        </Button>

    </StackPanel>

</Window>
