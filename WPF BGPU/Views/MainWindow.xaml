<Window x:Class="WPF_BGPU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WPF_BGPU.ViewModels"
        Title="Учёт личных финансов" Height="650" Width="950" Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <TabControl Margin="10">
        <!-- Транзакции -->
        <TabItem Header="Транзакции">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Фильтрация -->
                <GroupBox Header="Фильтрация" Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Начало периода"/>
                            <DatePicker SelectedDate="{Binding FilterStartDate}" Width="130"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Конец периода"/>
                            <DatePicker SelectedDate="{Binding FilterEndDate}" Width="130"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Категория"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding FilterCategory}" DisplayMemberPath="Name" Width="140"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Счёт"/>
                            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding FilterAccount}" DisplayMemberPath="Name" Width="140"/>
                        </StackPanel>
                        <Button Content="Применить" Command="{Binding ApplyFilterCommand}" Padding="8,3" Margin="0,0,5,0"/>
                        <Button Content="Сброс" Command="{Binding ResetFilterCommand}" Padding="8,3"/>
                    </StackPanel>
                </GroupBox>

                <!-- Добавление категории -->
                <GroupBox Header="Добавить категорию" Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="200" Text="{Binding NewCategoryName}" Margin="0,0,5,0"/>
                        <Button Content="Добавить" Command="{Binding AddCategoryCommand}" Padding="8,3"/>
                    </StackPanel>
                </GroupBox>

                <!-- Добавление транзакции -->
                <GroupBox Header="Добавить транзакцию" Grid.Row="2" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Дата"/>
                            <DatePicker SelectedDate="{Binding NewDate}" Width="120"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Счёт"/>
                            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding NewAccount}" DisplayMemberPath="Name" Width="140"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Категория"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding NewCategory}" DisplayMemberPath="Name" Width="140"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Сумма"/>
                            <TextBox Width="100" Text="{Binding NewAmount}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Описание"/>
                            <TextBox Width="250" Text="{Binding NewDescription}"/>
                        </StackPanel>
                        <Button Content="Добавить" Command="{Binding AddTransactionCommand}" Padding="8,3"/>
                    </StackPanel>
                </GroupBox>

                <!-- Таблица -->
                <DataGrid Grid.Row="3" ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AlternatingRowBackground="#EEEEEE">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=d}" Width="90"/>
                        <DataGridTextColumn Header="Счёт" Binding="{Binding Account.Name}" Width="120"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="120"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Итог -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Итого расходов:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat=N2}" FontWeight="Bold" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- Отчеты -->
        <TabItem Header="Отчёты">
            <ScrollViewer>
                <StackPanel Margin="10">
                    <TextBlock Text="Баланс по счетам:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Width="150"/>
                                    <TextBlock Text="{Binding Balance, StringFormat='{}{0:N2} ₽'}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Экспорт CSV" Command="{Binding ExportCsvCommand}" Padding="10,4" Margin="0,0,10,0"/>
                        <Button Content="Экспорт PDF" Command="{Binding ExportPdfCommand}" Padding="10,4"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
